{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "${homepage}",
        "sources": "${sources}",
        "issues": "${issues}"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.github.safetimamovic.throwablemobs.ThrowableMobsFabric"
        ],
        "modmenu": ["io.github.safetimamovic.throwablemobs.ModMenuIntegration"],
        "client": [
            "io.github.safetimamovic.throwablemobs.ThrowableMobsFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": "${fabric_loader_requirement}",
        "fabric-api": "${fabric_api_requirement}",
        "forgeconfigapiport": "${forgeconfigapiport_requirement}",
        "minecraft": "${minecraft_version_range_fabric}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "yet_another_config_lib_v3": "${yacl_requirement}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.kofi": "${donate}"
            }
        }
    }
}
